PORT=3000

NODE_ENV=development

LOG_LEVEL=info

SESSION_PATH=./sessions

WHATSAPP_GATEWAY_JWT_SECRET=change-me

# Browser origins allowed to call this gateway. Empty = none, which is correct
# when only Django (server-to-server) calls it.
CORS_ALLOWED_ORIGINS=

# Auto-connect saved sessions on boot. Keep false in development: `tsx watch`
# restarts on every file save, and each restart would re-login to WhatsApp.
RESTORE_SESSIONS_ON_BOOT=false
