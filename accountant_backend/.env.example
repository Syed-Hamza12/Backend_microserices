# Local dev: copy this file to .env and set DJANGO_DEBUG=True (below is
# production-shaped on purpose — see settings.py, which now refuses to start
# with DEBUG off unless SECRET_KEY/ALLOWED_HOSTS/DATABASE_URL are all set for
# real).
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated real domain(s) required once DJANGO_DEBUG=False, e.g.:
# DJANGO_ALLOWED_HOSTS=api.yourdomain.com
# Postgres DSN required once DJANGO_DEBUG=False — SQLite is dev-only.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Only needed if a browser-based client is ever added (native app HTTP
# requests aren't subject to CORS) — comma-separated origins, e.g.:
# DJANGO_CORS_ALLOWED_ORIGINS=https://admin.yourdomain.com
# Set to False only if TLS terminates somewhere Django can't detect via
# X-Forwarded-Proto (rare) — defaults to True whenever DEBUG=False.
# DJANGO_SECURE_SSL_REDIRECT=True
# Request-rate abuse protection (separate from apps.billing's per-plan AI
# usage caps) — defaults shown, override if you need to tune them:
# DJANGO_THROTTLE_ANON_RATE=30/minute
# DJANGO_THROTTLE_USER_RATE=120/minute
# DJANGO_THROTTLE_AUTH_RATE=10/minute
FASTAPI_INTERNAL_KEY=changeme-shared-secret
FASTAPI_BASE_URL=http://localhost:8001
# This MUST be the "Web application" type OAuth Client ID from Google Cloud
# Console (not the Android/iOS client) — the mobile app's GoogleSignIn is
# configured with this same ID as its `serverClientId`, which is what makes
# the ID token's `aud` claim match what this backend verifies against.
GOOGLE_OAUTH_CLIENT_ID=
MEDIA_ROOT=/absolute/path/to/repo/shared_media
# ============================================================
# WHO USES WHICH KEY POOL (read this first)
# ------------------------------------------------------------
# Four independent pools, each with its own rotation (see "ROTATION,
# every pool" below) so none of these features can exhaust another's
# free-tier daily quota:
#
#   Pool                    Function that calls it              Model setting
#   ----------------------  -----------------------------------  --------------------
#   GROQ_API_KEY*            apps.chat.groq_client.call_groq /    GROQ_MODEL_REASONING
#                            call_groq_text — chat's REASONING
#                            tier: bills, edits, documents, the
#                            Roman Urdu/Urdu response-writer
#                            pass, transliteration/speech-script
#                            conversion. Highest-volume chat
#                            traffic.
#   FAST_GEMINI_API_KEY*     apps.chat.google_client             GOOGLE_FAST_MODEL
#                            .call_gemma_planner — chat's FAST
#                            tier only (plain-text/simple
#                            replies, no bill/edit/document
#                            intent).
#   AUDIO_GEMINI_API_KEY*    apps.voice_transcriber.google_client GEMINI_AUDIO_MODEL
#                            .transcribe_audio — every recorded
#                            voice note, speech-to-text.
#   GEMINI_API_KEY*          apps.image_info_extractor            GEMINI_MODEL /
#                            .gemini_client.extract_receipt_data  GEMINI_TEXT_MODEL
#                            / generate_text — receipt/photo OCR
#                            (vision) ONLY.
#
# GROQ_MODEL_FAST is a fifth, narrower thing: it is NOT chat's fast tier —
# only apps.image_info_extractor.clarification's own separate two-tier
# split for OCR follow-up wording, on the Groq pool above.
#
# Why reasoning stays on Groq, not Gemini: this project's Gemini keys are
# capped as low as 20 requests/day on Flash models (Google cut free-tier
# Flash quotas ~50-80% in Dec 2025) — nowhere near enough for reasoning-tier
# volume. Groq's free tier (100,000 tokens/day per key) is far more
# workable at that traffic level.
#
# ROTATION, every pool: add up to 20 more accounts' keys as
# <PREFIX>_1, <PREFIX>_2, ... and the client automatically moves to the
# next one on ANY failure from the current key (a 429 rate limit is the
# expected case, but this isn't picky about the failure type) — no code
# changes needed, just add more numbered vars as you create more accounts.
# FAST_GEMINI_API_KEY*/AUDIO_GEMINI_API_KEY* each fall back to
# GEMINI_API_KEY*/_1../_20 if left unset entirely, so a single shared
# Gemini pool still works — but dedicated keys are recommended once any one
# feature starts hitting the shared pool's daily cap.
# ============================================================
GROQ_API_KEY=your-groq-api-key
# GROQ_API_KEY_1=second-groq-account-key
# GROQ_API_KEY_2=third-groq-account-key
# ...up to GROQ_API_KEY_20
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_REASONING=llama-3.3-70b-versatile

GEMINI_API_KEY=your-gemini-vision-ocr-api-key
# GEMINI_API_KEY_1=second-gemini-account-key
# ...up to GEMINI_API_KEY_20
# "-latest" aliases (maintained by Google) resolve to a current available
# model instead of a pinned version string that can get deprecated out from
# under you — pin to a dated version only if you need reproducible output.
GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_TEXT_MODEL / GEMINI_TEXT_FALLBACK_MODELS: a lighter model on the
# SAME vision pool above, for image_info_extractor's own text helper —
# leave unset to use the defaults in settings.py.

FAST_GEMINI_API_KEY=your-fast-tier-gemini-api-key
# FAST_GEMINI_API_KEY_1=second-account-key
# ...up to FAST_GEMINI_API_KEY_20
GOOGLE_FAST_MODEL=gemma-4-31b-it
# GOOGLE_FAST_FALLBACK_MODELS=some-other-model,another-fallback-model

AUDIO_GEMINI_API_KEY=your-audio-transcription-gemini-api-key
# AUDIO_GEMINI_API_KEY_1=second-account-key
# ...up to AUDIO_GEMINI_API_KEY_20
GEMINI_AUDIO_MODEL=gemini-3.1-flash-lite
# GEMINI_AUDIO_FALLBACK_MODELS=gemini-flash-latest

WHATSAPP_GATEWAY_BASE_URL=http://localhost:3000/api/v1
WHATSAPP_GATEWAY_JWT_SECRET=change-me-must-match-gateways-.env
