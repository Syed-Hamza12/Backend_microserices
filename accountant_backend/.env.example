# Local dev: copy this file to .env and set DJANGO_DEBUG=True (below is
# production-shaped on purpose — see settings.py, which now refuses to start
# with DEBUG off unless SECRET_KEY/ALLOWED_HOSTS/DATABASE_URL are all set for
# real).
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated real domain(s) required once DJANGO_DEBUG=False, e.g.:
# DJANGO_ALLOWED_HOSTS=api.yourdomain.com
# Postgres DSN required once DJANGO_DEBUG=False — SQLite is dev-only.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Only needed if a browser-based client is ever added (native app HTTP
# requests aren't subject to CORS) — comma-separated origins, e.g.:
# DJANGO_CORS_ALLOWED_ORIGINS=https://admin.yourdomain.com
# Set to False only if TLS terminates somewhere Django can't detect via
# X-Forwarded-Proto (rare) — defaults to True whenever DEBUG=False.
# DJANGO_SECURE_SSL_REDIRECT=True
# Request-rate abuse protection (separate from apps.billing's per-plan AI
# usage caps) — defaults shown, override if you need to tune them:
# DJANGO_THROTTLE_ANON_RATE=30/minute
# DJANGO_THROTTLE_USER_RATE=120/minute
# DJANGO_THROTTLE_AUTH_RATE=10/minute
FASTAPI_INTERNAL_KEY=changeme-shared-secret
FASTAPI_BASE_URL=http://localhost:8001
# This MUST be the "Web application" type OAuth Client ID from Google Cloud
# Console (not the Android/iOS client) — the mobile app's GoogleSignIn is
# configured with this same ID as its `serverClientId`, which is what makes
# the ID token's `aud` claim match what this backend verifies against.
GOOGLE_OAUTH_CLIENT_ID=
MEDIA_ROOT=/absolute/path/to/repo/shared_media
# ============================================================
# WHO USES WHICH KEY POOL (read this first)
# ------------------------------------------------------------
# GROQ_API_KEY*        -> chat's REASONING tier (bills, edits, documents,
#                         the Roman Urdu/Urdu response-writer pass,
#                         transliteration/speech-script conversion) — the
#                         highest-volume chat traffic. Also OCR's follow-up
#                         clarification wording (GROQ_MODEL_FAST).
# GEMINI_API_KEY*       -> receipt/photo OCR ONLY
#                         (apps.image_info_extractor.gemini_client).
# FAST_GEMINI_API_KEY*  -> chat's FAST tier only (Gemma, plain-text/simple
#                         replies). Falls back to GEMINI_API_KEY* if unset.
#
# Chat's reasoning tier deliberately stays on Groq, not Gemini: this
# project's Gemini keys are capped at as low as 20 requests/day on Flash
# models (Google cut free-tier Flash quotas ~50-80% in Dec 2025) — nowhere
# near enough for reasoning-tier volume. Groq's free tier (100,000
# tokens/day per key) is far more workable at this traffic level.
# ============================================================
GROQ_API_KEY=your-groq-api-key
# Optional free-tier key rotation: add up to 20 more accounts' keys here and
# apps.chat.groq_client automatically moves to the next one on ANY failure
# from the current key (a 429 rate limit is the expected case, but this
# isn't picky about the failure type) — no code changes needed, just add
# more numbered vars as you create more accounts. Each key attempt fails
# fast (max_retries=0 on the client — see groq_client.py's _client_for
# comment) so adding more keys doesn't multiply per-request latency the way
# it would if the SDK's own internal retry/backoff were left enabled.
# GROQ_API_KEY_1=second-groq-account-key
# GROQ_API_KEY_2=third-groq-account-key
# ...up to GROQ_API_KEY_20
# GROQ_MODEL_FAST is NOT chat's fast tier (that's Gemma/FAST_GEMINI_API_KEY
# below) — it's only apps.image_info_extractor.clarification's own separate,
# narrower two-tier split for OCR follow-up wording.
GROQ_MODEL_FAST=llama-3.1-8b-instant
# Chat's reasoning tier — see the "WHO USES WHICH KEY POOL" note above.
GROQ_MODEL_REASONING=llama-3.3-70b-versatile

GEMINI_API_KEY=your-gemini-api-key
# Same rotation convention as GROQ_API_KEY_1.._20 above, for Gemini — this
# pool is for receipt/photo OCR ONLY. Chat's fast tier below falls back to
# this pool if FAST_GEMINI_API_KEY isn't set, but a dedicated key is
# recommended so OCR and chat traffic don't compete for the same free-tier
# daily quota.
# GEMINI_API_KEY_1=second-gemini-account-key
# ...up to GEMINI_API_KEY_20
# "-latest" aliases (maintained by Google) resolve to a current available
# model instead of a pinned version string that can get deprecated out from
# under you — pin to a dated version only if you need reproducible output.
GEMINI_MODEL=gemini-flash-lite-latest

# Chat's fast/planner tier (see apps.chat.services.select_model_tier) — Gemma.
# FAST_GEMINI_API_KEY is its OWN key pool, separate from GEMINI_API_KEY
# (OCR) above. Falls back to GEMINI_API_KEY/_1../_20 if left unset, so a
# single shared pool still works — but add a dedicated key here if that
# shared pool starts hitting its free-tier daily cap under combined
# OCR+chat load.
FAST_GEMINI_API_KEY=your-fast-tier-gemini-api-key
# FAST_GEMINI_API_KEY_1=second-account-key
# ...up to FAST_GEMINI_API_KEY_20
GOOGLE_FAST_MODEL=gemma-4-31b-it
# GOOGLE_FAST_FALLBACK_MODELS=some-other-model,another-fallback-model

WHATSAPP_GATEWAY_BASE_URL=http://localhost:3000/api/v1
WHATSAPP_GATEWAY_JWT_SECRET=change-me-must-match-gateways-.env
